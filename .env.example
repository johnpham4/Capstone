# Hugging Face Configuration (get from https://huggingface.co/settings/tokens - need Write permission)
HF_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_ARN_ROLE=

COMET_API_KEY=
COMET_PROJECT=text2diagram-llm

OPENAI_API_KEY=

# Local vLLM (OpenAI-compatible)
LLM_ENDPOINT_URL=http://localhost:8001/v1

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=capstone

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax

# Google Auth
GOOGLE_CLIENT_ID=

# OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_REQUEST_WINDOW_SECONDS=900
OTP_HASH_SECRET=change-me-otp-secret

# SMTP (required for email OTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false

NGROK_AUTHTOKEN=
HF_AUTH=
